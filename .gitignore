# ================= Unity =================
# 缓存与生成目录（随 Unity 自动重建，不需要追踪）
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
MemoryCaptures/
Recordings/

# 资产导入产生的临时文件
*.csproj
*.sln
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity 崩溃与性能报告
sysinfo.txt
*.stackdump
crashlytics-build.properties

# ================= IDE =================
.vs/
.idea/
.vscode/
*.swp
*~

# ================= OS =================
Thumbs.db
Desktop.ini
.DS_Store

# ================= 项目自定义 =================
# 截图输出目录（MCP 调试截图，不入库）
Assets/Screenshots/
Assets/Screenshots.meta

# 打包输出目录（Windows 可执行包，不入库）
sworddemorun/

# Unity 云服务本机状态（打包/登录时反复变化，不入库）
ProjectSettings/UnityConnectSettings.asset
demoRun/
